  },
  "universalOptimizationPrinciples": [
    {"id": "PRINCIPLE-GLOBAL-REVIEW", "label": "全局审视", "description": "新增需求先检查整体结构、权威规则、优先级、重复与冲突，明确合并位置后再决定局部编辑或整体重写", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-ROOT-CAUSE-FIRST", "label": "失败根因优先", "description": "根据失败轨迹修复可复用根因，不只改表面话术", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-AVOID-PATCHES", "label": "不乱打补丁", "description": "禁止为单条用例或新增需求堆叠专用规则；优先合并或泛化替换权威规则，确认无法合并时才允许在对应职责章节新增局部规则", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-STRUCTURAL-EVIDENCE", "label": "结构证据优先", "description": "优先使用可观察的角色、顺序、状态、事件和字段关系表达判断条件；关键词只有在任务契约明确授权时才能作为决定性证据", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-FIELD-PROVENANCE", "label": "字段来源可追溯", "description": "使用字段前核对权威定义、生产者、写入时机和读取或推导链路，不得根据少量样本相关性反推字段语义", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-TEMPORAL-ANCHOR", "label": "时间锚点与观察窗口", "description": "涉及时序时先定位首次或决定性事件，再明确事件前后或完整观察窗口；不涉及时序时明确声明不适用", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-BOUNDARY-PAIRS", "label": "正反边界成对验证", "description": "每个根因使用表象相似但结论不同的正反边界验证，示例描述可泛化结构而不复制评测原文或偶然值", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-CONCISE", "label": "提示词精简", "description": "删除无效重复和冲突表达，在不损失能力的前提下降低提示词复杂度", "defaultSelected": false, "validation": "semantic"},
    {"id": "PRINCIPLE-PRESERVE-PLACEHOLDERS", "label": "变量占位符不可动", "description": "保持全部既有运行时占位符名称和集合", "defaultSelected": true, "validation": "deterministic"},
    {"id": "PRINCIPLE-PRESERVE-CAPABILITIES", "label": "不删除既有功能", "description": "未获用户授权时不得删除原提示词已有业务能力和分支", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-PRESERVE-FORMAT", "label": "保持原格式", "description": "未获用户授权时保持既有输出协议、固定标识和结构契约", "defaultSelected": true, "validation": "semantic"},
    {"id": "PRINCIPLE-PRESERVE-TOOL-INTERFACE", "label": "函数名参数名不可动", "description": "未获用户授权时不得修改函数名和参数名", "defaultSelected": true, "validation": "deterministic"}
  ],
